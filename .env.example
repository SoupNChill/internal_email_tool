# emaild configuration -- copy to .env and fill in.
# release_rules §16: every variable declares whether it is required, secret,
# and whether changing it requires a restart or a migration.

# ---------------------------------------------------------------------------
# Core (required, all roles)
# ---------------------------------------------------------------------------
EMAILD_ROLE=api                  # api | worker | admin -- see "Secret separation" below
EMAILD_ENV=development           # development | production
EMAILD_DATABASE_URL=postgresql+asyncpg://emaild:CHANGEME@postgres:5432/emaild
EMAILD_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Secret separation (deployment_and_release.md §3)
#
# These are deliberately NOT all loaded by every process. The public API never
# holds the MXRoute admin key, so compromising the internet-facing surface does
# not yield the ability to delete mailboxes or touch reseller users.
#
#   api    -> MAILBOX_ENCRYPTION_KEY forbidden,   MXROUTE_* forbidden
#   worker -> MAILBOX_ENCRYPTION_KEY required,    MXROUTE_* forbidden
#   admin  -> MAILBOX_ENCRYPTION_KEY required,    MXROUTE_* per command
#
# "per command" because most admin commands -- keys, projects, suppressions --
# never touch MXRoute; only provisioning does. The check lives at the point of
# use in emaild/admin.py rather than on the role (F-16).
#
# In a PRODUCTION install (deploy/compose.yaml) the encryption key is not set
# here at all: it generates itself into a volume on first boot. This file is
# for local development, where there are no volumes to generate into.
#
# Startup fails loudly if a role is given a secret it must not have.
# ---------------------------------------------------------------------------

# SECRET. Required for role=worker and role=admin. Fernet key, 44 chars base64.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# release_rules §44: NEVER rotate implicitly during an upgrade. Losing this means
# re-provisioning every mailbox password through the MXRoute API.
EMAILD_MAILBOX_ENCRYPTION_KEY=

# SECRET. Required for role=admin ONLY. Account-root credential -- it can delete
# mailboxes and manage reseller users, not merely read.
EMAILD_MXROUTE_SERVER=
EMAILD_MXROUTE_USERNAME=
EMAILD_MXROUTE_API_KEY=

# ---------------------------------------------------------------------------
# Provider limits -- defaults observed on chocobo.mxrouting.net (spike_results.md).
# The worker prefers values advertised in the EHLO LIMITS banner at connect time;
# these are the fallback when a server does not advertise them.
# ---------------------------------------------------------------------------
EMAILD_SMTP_PORT=465                     # implicit TLS; negotiated TLS 1.3
EMAILD_SMTP_TIMEOUT_SECONDS=30
EMAILD_FALLBACK_MAX_MESSAGE_BYTES=52428800   # 50 MB  (EHLO SIZE)
EMAILD_FALLBACK_MAX_RECIPIENTS=150           # (EHLO RCPTMAX)
EMAILD_FALLBACK_MAX_MESSAGES_PER_CONNECTION=100  # (EHLO MAILMAX)

# Hourly send ceiling per sender identity. MXRoute rejects over-limit with a
# PERMANENT 5xx and does not queue -- so this is a hard gate, not a throttle.
# We stay under their ceiling by the safety margin below. Do not raise to 1.0.
EMAILD_HOURLY_LIMIT=400
EMAILD_RATE_LIMIT_SAFETY_MARGIN=0.9

# ---------------------------------------------------------------------------
# Retention (vision.md: no accidental archive of password-reset links)
# ---------------------------------------------------------------------------
EMAILD_BODY_RETENTION_HOURS=72       # purge bodies this long after terminal state
EMAILD_IDEMPOTENCY_TTL_HOURS=24

# ---------------------------------------------------------------------------
# Network. release_rules §46: trust forwarded headers ONLY from the tunnel.
# Empty means trust nothing, which is correct for local development.
# ---------------------------------------------------------------------------
EMAILD_TRUSTED_PROXY_HOSTS=

# ---------------------------------------------------------------------------
# Dashboard. Shows recipient addresses, subjects, and volume -- treat as real
# data. Serving it unauthenticated in production is refused unless you say so.
# ---------------------------------------------------------------------------
EMAILD_DASHBOARD_ENABLED=true
# SECRET. If set, the dashboard requires HTTP Basic auth (any username).
EMAILD_DASHBOARD_TOKEN=
# Set true ONLY when Cloudflare Access (or equivalent) authenticates the
# dashboard routes in front of this service. Do not set it for /v1/* -- machine
# clients cannot complete an SSO challenge.
EMAILD_DASHBOARD_BEHIND_PROXY_AUTH=false
